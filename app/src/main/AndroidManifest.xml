<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.microblink.photomath" />
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.lite" />
        <package android:name="com.instagram.barcelona" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.strava" />
        <package android:name="com.alltrails.alltrails" />
        <package android:name="com.cloudflare.onedotonedotonedotone" />
        <package android:name="com.duolingo" />
        <package android:name="com.intsig.camscanner" />
        <package android:name="com.adobe.lrmobile" />
        <package android:name="cn.wps.moffice_eng" />
        <package android:name="jp.ne.ibis.ibispaintx.app" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.getcontact.app" />
        <package android:name="com.nexstreaming.app.kinemasterfree" />
        <package android:name="com.canva.editor" />
        <package android:name="com.snowcorp.stickerly.android" />
        <package android:name="eu.darken.sdmse" />
        <package android:name="com.wolfram.android.alpha" />
        <package android:name="com.kahoot.android" />
        <package android:name="com.adobe.scan.android" />
        <package android:name="jp.co.shueisha.mangaplus" />
        <package android:name="org.zwanoo.android.speedtest" />
        <package android:name="com.digibites.accubattery" />
        <package android:name="com.arlosoft.macrodroid" />
        <package android:name="com.rarlab.rar" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.zhiliaoapp.musically.go" />
        <package android:name="com.ss.android.ugc.trill.go" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" tools:ignore="MockLocation" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- Required permissions for Universal Auto-Sender -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <permission android:name="com.rhdevs.rhpatch.permission.SEND_RECEIVE_WPP" android:protectionLevel="signatureOrSystem" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />


    <application
        android:extractNativeLibs="false"
        android:forceQueryable="true"
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_new"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@drawable/ic_launcher_new"
        android:supportsRtl="true"
        tools:targetApi="30">

        <!--suppress AndroidDomInspection -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data
                android:name="photopicker_activity:0:required"
                android:value="" />
        </service>


        <activity
            android:name="com.rhdevs.rhpatch.activity.ElementHiderActivity"
            android:label="Filter Elemen UI"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />
        <activity
            android:name="com.rhdevs.rhpatch.activity.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.rhdevs.rhpatch.activity.DnsAppPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <receiver
            android:name=".activity.LogReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.rhdevs.rhpatch.LOG_SPAM" />
            </intent-filter>
        </receiver>

        <!-- ContentProvider for SELinux IPC Bypass (Settings Reader) -->
        <provider
            android:name="com.rhdevs.rhpatch.system.SpamConfigProvider"
            android:authorities="com.rhdevs.rhpatch.provider"
            android:exported="true"
            android:grantUriPermissions="true" />

        <activity
            android:name="com.rhdevs.rhpatch.activity.AntiSpamActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />
            
        <activity
            android:name="com.rhdevs.rhpatch.activity.TikTokSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name="com.rhdevs.rhpatch.activity.AppPatchSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
        </activity>


        <activity
            android:name="com.rhdevs.rhpatch.activity.SchedulerDashboardActivity"
            android:label="Universal Scheduler"
            android:theme="@style/AppTheme"
            android:exported="false" />
            
        <activity
            android:name="com.rhdevs.rhpatch.activity.ComposeScheduleActivity"
            android:label="Buat Jadwal"
            android:theme="@style/AppTheme"
            android:exported="false" />
            
        <activity
            android:name="com.rhdevs.rhpatch.activity.AutomationCountdownActivity"
            android:label="Menjalankan Jadwal..."
            android:theme="@style/AppTheme"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:exported="false" />
            
        <activity
            android:name="com.rhdevs.rhpatch.activity.PermissionCheckActivity"
            android:label="Pemeriksaan Izin"
            android:theme="@style/AppTheme"
            android:exported="false" />
            
        <activity
            android:name="com.rhdevs.rhpatch.activity.TroubleshootingActivity"
            android:label="Pusat Bantuan"
            android:theme="@style/AppTheme"
            android:exported="false" />
            
        <activity
            android:name="com.rhdevs.rhpatch.activities.CrashReportActivity"
            android:label="Crash Report"
            android:theme="@style/AppTheme" />
            
        <activity
            android:name="com.rhdevs.rhpatch.ui.ScreenLockConfigActivity"
            android:label="Lock Screen Config"
            android:theme="@style/AppTheme"
            android:exported="false" />

        <receiver
            android:name="com.rhdevs.rhpatch.scheduler.UniversalAlarmReceiver"
            android:exported="false">
        </receiver>

        <activity
            android:name=".activities.TextEditorActivity"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".activities.CallRecordingSettingsActivity"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.SearchActivity"
            android:theme="@style/AppTheme"
            android:parentActivityName=".activities.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ForceStartActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <service
            android:name=".xposed.bridge.service.BridgeService"
            android:exported="true"
            tools:ignore="ExportedService" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".xposed.bridge.providers.HookProvider"
            android:authorities="${applicationId}.hookprovider"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <provider
            android:name=".provider.RemotePreferenceProvider"
            android:authorities="${applicationId}.preferences"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />


        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/app_desc" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />

        <receiver
            android:name=".receivers.WAFReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.facebook.GET_PHONE_ID" />
                <action android:name="android.support.customtabs.action.CustomTabsService"/>
            </intent-filter>
        </receiver>

        <!-- Message Scheduler & Auto Reply Components -->
        <activity
            android:name=".activities.MessageSchedulerActivity"
            android:theme="@style/AppTheme"
            android:label="Message Scheduler"
            android:exported="true"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.EditScheduledMessageActivity"
            android:theme="@style/AppTheme"
            android:label="Schedule Message"
            android:exported="true"
            android:parentActivityName=".activities.MessageSchedulerActivity" />

        <activity
            android:name=".activities.AutoReplyActivity"
            android:theme="@style/AppTheme"
            android:label="Auto Reply"
            android:exported="true"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.EditAutoReplyRuleActivity"
            android:theme="@style/AppTheme"
            android:label="Auto Reply Rule"
            android:exported="true"
            android:parentActivityName=".activities.AutoReplyActivity" />

        <activity
            android:name=".activities.FakeDisplayActivity"
            android:theme="@style/AppTheme"
            android:label="Fake Display Settings"
            android:exported="true"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.FakeCallActivity"
            android:theme="@style/AppTheme"
            android:label="Simulated Call"
            android:exported="true"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.CustomFoldersActivity"
            android:theme="@style/AppTheme"
            android:label="Custom Chat Folders"
            android:exported="true"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.EditFolderActivity"
            android:theme="@style/AppTheme"
            android:label="Edit Folder"
            android:exported="true"
            android:parentActivityName=".activities.CustomFoldersActivity" />

        <service
            android:name=".services.SchedulerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Automated message scheduling and auto-reply triggered by local alarm events" />
        </service>

        <receiver
            android:name=".receivers.SchedulerReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.rhdevs.rhpatch.TRIGGER_ALARM" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.SchedulerStatusReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.rhdevs.rhpatch.SCHEDULED_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Auto Sender Accessibility Service -->
        <service
            android:name="com.rhdevs.rhpatch.services.AutoSenderAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Auto Reply Notification Listener Service -->
        <service
            android:name="com.rhdevs.rhpatch.services.AutoReplyService"
            android:label="Rhpatch Auto Reply"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.rhdevs.rhpatch.receivers.WaDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    
        <service android:name=".service.AntiSpamCallService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <activity
            android:name=".activity.MapActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />
        <service
            android:name=".service.MockLocationService"
            android:foregroundServiceType="location"
            android:exported="false" />

    
        <activity
            android:name=".activity.ThemeStoreActivity"
            android:label="Theme Store"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar"
            android:exported="false" />
            <activity
            android:name=".activity.ThemeStudioActivity"
            android:label="Visual Theme Studio"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />
    </application>
</manifest>





