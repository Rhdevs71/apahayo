<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pusat Pemecahan Masalah"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jika jadwal otomatisasi tidak berjalan, periksa dan aktifkan pengaturan berikut pada perangkat Anda."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Battery Optimization -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E293B"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Pengoptimalan Baterai"
                    android:textColor="#3B82F6"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cegah sistem menjeda aplikasi ini saat berada di latar belakang. Pilih 'Tidak Dibatasi'."
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_trouble_battery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cek Pengaturan Baterai"
                    android:backgroundTint="#3B82F6"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Autostart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E293B"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Mulai Otomatis (Autostart)"
                    android:textColor="#10B981"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wajib untuk pengguna HP Xiaomi, Oppo, Vivo, dan Poco agar alarm tidak dimatikan paksa."
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_trouble_autostart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kelola Mulai Otomatis"
                    android:backgroundTint="#10B981"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Accessibility Restart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E293B"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Restart Aksesibilitas"
                    android:textColor="#F59E0B"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jika aplikasi gagal mengetik pesan, coba matikan lalu hidupkan kembali layanan Aksesibilitas Rhpatch."
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_trouble_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buka Aksesibilitas"
                    android:backgroundTint="#F59E0B"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Notification Access -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E293B"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Akses Pemberitahuan"
                    android:textColor="#8B5CF6"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diperlukan untuk fitur balas pesan otomatis (Auto Reply) agar dapat membaca pesan masuk."
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_trouble_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Izinkan Pemberitahuan"
                    android:backgroundTint="#8B5CF6"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
