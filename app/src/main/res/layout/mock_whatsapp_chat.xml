<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b141a"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1f2c34"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#e9edef" />
            
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@android:drawable/sym_def_app_icon"
            app:tint="#8696a0"/>
            
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="Bestie"
            android:textColor="#e9edef"
            android:textSize="18sp"
            android:textStyle="bold" />
            
        <!-- Video Call -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/presence_video_online"
            app:tint="#e9edef" />
            
        <!-- Voice Call -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_menu_call"
            app:tint="#e9edef" />
            
        <!-- More -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#e9edef" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/conversation_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp">

        <!-- Bubble Left -->
        <LinearLayout
            android:id="@+id/bubble_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="64dp"
            android:background="@drawable/bg_bubble_left"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hai kamu!"
                android:textColor="#e9edef"
                android:textSize="16sp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:text="8.03"
                android:textColor="#8696a0"
                android:textSize="11sp"/>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="64dp"
            android:background="@drawable/bg_bubble_left"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sudah lama nggak ketemu.\nNggak sabar nunggu ketemuan besok."
                android:textColor="#e9edef"
                android:textSize="16sp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:text="8.03"
                android:textColor="#8696a0"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Bubble Right -->
        <LinearLayout
            android:id="@+id/bubble_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginStart="64dp"
            android:background="@drawable/bg_bubble_right"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sama dong!"
                android:textColor="#e9edef"
                android:textSize="16sp"/>
                
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.03"
                    android:textColor="#8696a0"
                    android:textSize="11sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="#53bdeb" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_entry"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">
            
            <ImageView
                android:id="@+id/emoji_picker_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#8696a0" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:text="Ketik pesan"
                android:textColor="#8696a0"
                android:textSize="18sp"/>

            <ImageView
                android:id="@+id/input_attach_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_add"
                app:tint="#8696a0" />

            <ImageView
                android:id="@+id/camera_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="4dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#8696a0" />
        </LinearLayout>

        <ImageView
            android:id="@+id/voice_note_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_mic"
            android:elevation="1dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="#111b21" />
    </LinearLayout>
</LinearLayout>
