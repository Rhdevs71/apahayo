<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B0E14"
        app:elevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_down"
                android:rotation="90"
                app:tint="#E3E6EB"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btn_back"
                android:layout_marginStart="12dp"
                android:text="Fake Display Settings"
                android:textColor="#E3E6EB"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Target Selection Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bordered_box"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target Settings"
                    android:textColor="#9C87F2"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Change Self Switch -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fake my own profile (Self/Me)"
                        android:textColor="#E3E6EB"
                        android:textSize="16sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_is_self"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        app:thumbTint="@android:color/white"
                        app:trackTint="#9C87F2" />
                </RelativeLayout>

                <!-- Select Contact (visible only when switch_is_self is false) -->
                <LinearLayout
                    android:id="@+id/layout_contact_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Contact"
                        android:textColor="#8F9CAE"
                        android:textSize="12sp"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="-8dp"
                        android:elevation="2dp"
                        android:background="#141A26"
                        android:paddingHorizontal="4dp" />

                    <LinearLayout
                        android:id="@+id/btn_select_contact"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_bordered_box_nested"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#8F9CAE" />

                        <TextView
                            android:id="@+id/text_selected_contact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Choose WhatsApp contact"
                            android:textColor="#8F9CAE"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Fake Name Override Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bordered_box"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Override Name"
                        android:textColor="#9C87F2"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_name_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        app:thumbTint="@android:color/white"
                        app:trackTint="#9C87F2" />
                </RelativeLayout>

                <!-- Name Input Box (enabled only when switch_name_enabled is checked) -->
                <LinearLayout
                    android:id="@+id/layout_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_bordered_box_nested"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:alpha="0.5">

                    <EditText
                        android:id="@+id/edit_fake_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="Enter fake display name"
                        android:textColor="#E3E6EB"
                        android:textColorHint="#5A687C"
                        android:textSize="16sp"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fake Photo Override Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bordered_box"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Override Profile Picture"
                        android:textColor="#9C87F2"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_photo_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        app:thumbTint="@android:color/white"
                        app:trackTint="#9C87F2" />
                </RelativeLayout>

                <!-- Select Photo Layout (enabled only when switch_photo_enabled is checked) -->
                <RelativeLayout
                    android:id="@+id/layout_photo_input"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_bordered_box_nested"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:alpha="0.5">

                    <ImageView
                        android:id="@+id/img_photo_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:tint="#8F9CAE" />

                    <TextView
                        android:id="@+id/text_selected_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/img_photo_icon"
                        android:layout_marginStart="12dp"
                        android:text="Choose fake photo"
                        android:textColor="#8F9CAE"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/btn_select_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:text="SELECT"
                        android:textColor="#9C87F2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:clickable="false"
                        android:focusable="false" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#C3B4FC"
                android:text="Save"
                android:textColor="#0B0E14"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
