<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:keepScreenOn="true">

    <!-- Blur Background or Dark Overlay -->
    <ImageView
        android:id="@+id/img_bg_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.2"
        android:src="@drawable/ic_round_account_circle_24" />

    <!-- Top Info Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:padding="20dp">

        <TextView
            android:id="@+id/text_call_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Name"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WhatsApp Voice Call"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/text_call_substatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming..."
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Profile Photo Center -->
    <androidx.cardview.widget.CardView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerInParent="true"
        app:cardCornerRadius="70dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#1A222D">

        <ImageView
            android:id="@+id/img_call_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_round_account_circle_24" />
    </androidx.cardview.widget.CardView>

    <!-- Bottom Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="60dp"
        android:paddingHorizontal="40dp">

        <!-- Incoming Call Actions (Accept & Decline) -->
        <LinearLayout
            android:id="@+id/layout_incoming_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Decline Button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btn_decline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="#E53935"
                    app:fabSize="normal"
                    app:tint="#FFFFFF"
                    android:src="@drawable/ic_round_call_end_24"
                    android:contentDescription="Decline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Decline"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="40dp"
                android:layout_height="1dp" />

            <!-- Accept Button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btn_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="#4CAF50"
                    app:fabSize="normal"
                    app:tint="#FFFFFF"
                    android:src="@drawable/ic_round_call_24"
                    android:contentDescription="Accept" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accept"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Call Actions (Mute, Speaker, End) -->
        <LinearLayout
            android:id="@+id/layout_active_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <!-- Top Row: Icons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="40dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_round_mic_off_24"
                    android:alpha="0.6"
                    android:contentDescription="Mute" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_round_volume_up_24"
                    android:alpha="0.6"
                    android:contentDescription="Speaker" />
            </LinearLayout>

            <!-- End Call Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_end_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:backgroundTint="#E53935"
                app:fabSize="normal"
                app:tint="#FFFFFF"
                android:src="@drawable/ic_round_call_end_24"
                android:contentDescription="End Call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Call"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
