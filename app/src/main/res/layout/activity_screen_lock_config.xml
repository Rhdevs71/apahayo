<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
            app:navigationIconTint="?colorOnSurface"
            app:title="Konfigurasi Kunci Layar"
            app:titleTextColor="?colorOnSurface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?colorOutlineVariant" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Pilih jenis kunci layar yang saat ini Anda gunakan di perangkat Anda agar sistem otomatisasi tahu cara membukanya."
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/radio_group_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:buttonTint="?colorPrimary"
                    android:text="Tidak Ada Kunci (Langsung Terbuka)"
                    android:textColor="?colorOnSurface" />

                <RadioButton
                    android:id="@+id/radio_swipe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:buttonTint="?colorPrimary"
                    android:text="Geser (Swipe)"
                    android:textColor="?colorOnSurface" />

                <RadioButton
                    android:id="@+id/radio_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:buttonTint="?colorPrimary"
                    android:text="PIN (Angka)"
                    android:textColor="?colorOnSurface" />

                <RadioButton
                    android:id="@+id/radio_pass_num"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:buttonTint="?colorPrimary"
                    android:text="Kata Sandi Numerik (Angka + Enter)"
                    android:textColor="?colorOnSurface" />

                <RadioButton
                    android:id="@+id/radio_pass_alphanum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:buttonTint="?colorPrimary"
                    android:text="Kata Sandi Alfanumerik (Teks + Enter)"
                    android:textColor="?colorOnSurface" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Masukkan PIN / Kata Sandi"
                app:boxBackgroundColor="?colorSurfaceContainer"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeWidth="0dp"
                app:hintTextColor="?colorOnSurfaceVariant"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="?colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="?colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Simpan Konfigurasi"
                android:textColor="?colorOnPrimary"
                android:textSize="15sp"
                app:backgroundTint="?colorPrimary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>